<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de una opción o de una tele de la lista: se aclara y gana borde con el foco o al elegirla. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_selected="true">
    <shape android:shape="rectangle">
      <solid android:color="@color/tarjeta_foco"/>
      <stroke android:width="2dp" android:color="@color/acento"/>
      <corners android:radius="8dp"/>
    </shape>
  </item>
  <item android:state_focused="true">
    <shape android:shape="rectangle">
      <solid android:color="@color/tarjeta_foco"/>
      <stroke android:width="2dp" android:color="@color/texto_suave"/>
      <corners android:radius="8dp"/>
    </shape>
  </item>
  <item android:state_pressed="true">
    <shape android:shape="rectangle">
      <solid android:color="@color/tarjeta_foco"/>
      <corners android:radius="8dp"/>
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/tarjeta"/>
      <corners android:radius="8dp"/>
    </shape>
  </item>
</selector>
