<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true">
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/titulo"
        android:textColor="@color/texto"
        android:textSize="24sp"
        android:textStyle="bold"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/bajada"
        android:textColor="@color/texto_suave"
        android:textSize="14sp"/>

    <TextView
        android:id="@+id/estado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/opcion"
        android:padding="14dp"
        android:text="@string/sin_transmitir"
        android:textColor="@color/texto"
        android:textSize="15sp"/>

    <Button
        android:id="@+id/accion"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/principal"
        android:text="@string/transmitir"
        android:textAllCaps="false"
        android:textColor="@color/sobre_acento"
        android:textSize="17sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/teles"
        android:textColor="@color/texto_suave"
        android:textSize="13sp"/>
    <LinearLayout
        android:id="@+id/teles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>
    <TextView
        android:id="@+id/buscando"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/buscando"
        android:textColor="@color/texto_suave"
        android:textSize="14sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ip_etiqueta"
        android:textColor="@color/texto_suave"
        android:textSize="13sp"/>
    <EditText
        android:id="@+id/ip"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/opcion"
        android:hint="@string/ip_ejemplo"
        android:imeOptions="actionDone"
        android:inputType="textUri"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:singleLine="true"
        android:textColor="@color/texto"
        android:textColorHint="@color/texto_suave"
        android:textSize="16sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/opciones"
        android:textColor="@color/texto_suave"
        android:textSize="13sp"/>
    <LinearLayout
        android:id="@+id/opciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/nota_sonido"
        android:textColor="@color/texto_suave"
        android:textSize="12sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/actualizaciones"
        android:textColor="@color/texto_suave"
        android:textSize="13sp"/>
    <LinearLayout
        android:id="@+id/actualizaciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>
    <TextView
        android:id="@+id/aviso_actualizacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/nota_actualizaciones"
        android:textColor="@color/texto_suave"
        android:textSize="12sp"/>
  </LinearLayout>
</ScrollView>
