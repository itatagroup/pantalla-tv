<Project Sdk="Microsoft.NET.Sdk">

  <!-- F4: prototipo que mide la captura de audio POR PROCESO (process loopback de WASAPI). Herramienta
       de medición: no forma parte del instalador ni toca nada del emisor. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>AudioPrueba</AssemblyName>
    <RootNamespace>PantallaTv.Audio.Prueba</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PantallaTv.Audio.Prueba.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
